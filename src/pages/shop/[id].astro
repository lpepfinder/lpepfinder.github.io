---
import Base from '../../layouts/Base.astro';
import RecordList from '../../components/RecordList.astro';
import config from '../../../data/config.json';
import { newArrivals } from '../../lib/new-arrivals.js';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t, tn, defaultLanguage as lang, number, countryName, localPath } from '../../lib/i18n.js';
import { catalog } from '../../lib/catalog.js';
import { pageTitle, breadcrumbLd } from '../../lib/seo.js';

/** One page per shop, default language only: hubs are localized, detail pages are not. */
export function getStaticPaths() {
  return catalog().visible.map((shop) => ({ params: { id: shop.id }, props: { shop } }));
}
const { shop } = Astro.props;
const c = catalog();
const country = shop.country && countryName(lang, shop.country);
const place = [shop.city, country].filter(Boolean).join(', ');
const searchable = c.visible.filter((s) => s.records).length;
const vars = {
  shop: shop.name, city: shop.city ? `, ${shop.city}` : '', place: place ? ` (${place})` : '',
  records: number(lang, shop.records), shops: number(lang, Math.max(searchable - 1, 0)),
};
const key = shop.records ? 'shop' : 'shopListed';
const fresh = newArrivals().shop(shop.id, config.newArrivals.shopItems);
const feed = shop.records ? { href: `/feed/shop/${shop.id}.xml`, title: t(lang, 'feedShopTitle', { shop: shop.name }) } : undefined;
const pageUrl = new URL(`/shop/${shop.id}/`, Astro.site).href;
const crumbs = [
  { name: t(lang, 'breadcrumbHome'), href: '/' },
  { name: t(lang, 'navShops'), href: '/shops/' },
  ...(shop.country ? [{ name: country, href: `/shops/${shop.country.toLowerCase()}/` }] : []),
  { name: shop.name, href: `/shop/${shop.id}/` },
];
const ld = [{
  '@context': 'https://schema.org', '@type': 'RecordStore', '@id': `${pageUrl}#store`, name: shop.name, url: shop.url, sameAs: [shop.url],
  address: shop.country ? { '@type': 'PostalAddress', addressCountry: shop.country, addressLocality: shop.city || undefined } : undefined,
}, breadcrumbLd(crumbs, Astro.site)];
---
<Base lang={lang} title={pageTitle(t(lang, `${key}Title`, vars))} description={t(lang, `${key}Description`, vars)} ld={ld} feed={feed} noindex={!shop.records}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <article>
    <h1>{shop.name}</h1>
    <p>
      {place && (shop.country ? <a href={localPath(lang, `/shops/${shop.country.toLowerCase()}/`)}>{place}</a> : place)}
      {place && ' · '}
      {shop.records ? tn(lang, 'shopRecords', shop.records) : t(lang, 'shopListedOnly')}
    </p>
    <p><a href={shop.url} rel="noopener" kind="strong"><span>{t(lang, 'shopVisit')}: {new URL(shop.url).host}</span><vf-icon name="external"></vf-icon></a></p>
    {fresh.count > 0 && (
      <section>
        <h2 id="shop-new">{t(lang, 'shopNewTitle', { count: number(lang, fresh.count) })}</h2>
        <RecordList lang={lang} records={fresh.records} labelledby="shop-new" showShop={false} />
      </section>
    )}
    {feed && <p><a href={feed.href} type="application/atom+xml">{t(lang, 'newFeed')}</a></p>}
    {shop.latest.length > 0 && <h2 id="shop-latest">{t(lang, 'shopLatest')}</h2>}
    {shop.latest.length > 0 && <RecordList lang={lang} records={shop.latest} labelledby="shop-latest" showShop={false} />}
  </article>
</Base>
