---
import Base from '../../layouts/Base.astro';
import RecordTable from '../../components/RecordTable.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { t, defaultLanguage as lang, number, countryName, localPath } from '../../lib/i18n.js';
import { catalog } from '../../lib/catalog.js';
import { pageTitle, breadcrumbLd } from '../../lib/seo.js';

/** One page per shop, default language only: hubs are localized, detail pages are not. */
export function getStaticPaths() {
  return catalog().visible.map((shop) => ({ params: { id: shop.id }, props: { shop } }));
}
const { shop } = Astro.props;
const c = catalog();
const country = shop.country && countryName(lang, shop.country);
const place = [shop.city, country].filter(Boolean).join(', ');
const searchable = c.visible.filter((s) => s.records).length;
const vars = {
  shop: shop.name, city: shop.city ? `, ${shop.city}` : '', place: place ? ` (${place})` : '',
  records: number(lang, shop.records), shops: number(lang, Math.max(searchable - 1, 0)),
};
const key = shop.records ? 'shop' : 'shopListed';
const pageUrl = new URL(`/shop/${shop.id}/`, Astro.site).href;
const crumbs = [
  { name: t(lang, 'breadcrumbHome'), href: '/' },
  { name: t(lang, 'navShops'), href: '/shops/' },
  ...(shop.country ? [{ name: country, href: `/shops/${shop.country.toLowerCase()}/` }] : []),
  { name: shop.name, href: `/shop/${shop.id}/` },
];
const ld = [{
  '@context': 'https://schema.org', '@type': 'RecordStore', '@id': `${pageUrl}#store`, name: shop.name, url: shop.url, sameAs: [shop.url],
  address: shop.country ? { '@type': 'PostalAddress', addressCountry: shop.country, addressLocality: shop.city || undefined } : undefined,
}, breadcrumbLd(crumbs, Astro.site)];
---
<Base lang={lang} title={pageTitle(t(lang, `${key}Title`, vars))} description={t(lang, `${key}Description`, vars)} ld={ld} noindex={!shop.records}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <article>
    <h1>{shop.name}</h1>
    <p>
      {place && (shop.country ? <a href={localPath(lang, `/shops/${shop.country.toLowerCase()}/`)}>{place}</a> : place)}
      {place && ' · '}
      {shop.records ? t(lang, 'shopRecords', { count: number(lang, shop.records) }) : t(lang, 'shopListedOnly')}
    </p>
    <p><a href={shop.url} rel="noopener">{t(lang, 'shopVisit')}: {new URL(shop.url).host}</a></p>
    {shop.latest.length > 0 && <h2>{t(lang, 'shopLatest')}</h2>}
    {shop.latest.length > 0 && <RecordTable lang={lang} records={shop.latest} shopsById={c.shopsById} showShop={false} />}
  </article>
</Base>
