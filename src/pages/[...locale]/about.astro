---
import Base from '../../layouts/Base.astro';
import config from '../../../data/config.json';
import { t, localeParams } from '../../lib/i18n.js';

export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const ld = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: t(lang, 'aboutTitle'), inLanguage: lang }, { '@context': 'https://schema.org', '@type': 'Organization', name: config.name, alternateName: config.formerNames, url: config.baseUrl, email: config.contactEmail, logo: `${config.baseUrl}/favicon.png` }];
---
<Base lang={lang} path="/about/" title={t(lang, 'aboutTitle')} description={t(lang, 'aboutBody')[0]} ld={ld}>
  <article>
    <h1>{t(lang, 'aboutTitle')}</h1>
    {t(lang, 'aboutBody').map((p) => <p>{p}</p>)}
    <h2>{t(lang, 'aboutDataTitle')}</h2>
    <p>{t(lang, 'aboutData')}</p>
    <h2>{t(lang, 'aboutContactTitle')}</h2>
    <ul>
      <li>{t(lang, 'footerEmail')}: <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a></li>
      <li><a href={config.chat}>{t(lang, 'footerChat')}</a></li>
      <li><a href={config.repository}>{t(lang, 'footerGithub')}</a></li>
    </ul>
  </article>
</Base>
