---
import Moved from '../../components/Moved.astro';
import { localeParams, localPath } from '../../lib/i18n.js';

/** /more/ moved to /settings/: old links and bookmarks keep working. */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
---
<Moved to={localPath(lang, '/settings/')} />
