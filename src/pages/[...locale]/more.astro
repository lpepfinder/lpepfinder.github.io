---
import Base from '../../layouts/Base.astro';
import CurrencySelect from '../../components/CurrencySelect.astro';
import config from '../../../data/config.json';
import { t, languages, localeParams, localPath } from '../../lib/i18n.js';
import { pageTitle } from '../../lib/seo.js';

/**
 * The More tab: what the footer holds on a website, as an app screen. Browse (shops, artists),
 * settings (prices in, language), a shop to add, and about (privacy, data status, source).
 */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const groups = [
  { title: 'moreBrowse', links: [
    { href: localPath(lang, '/shops/'), key: 'navShops', icon: 'store' },
    { href: '/artists/', key: 'navArtists', icon: 'person' },
    { href: '/new/', key: 'tabNew', icon: 'record' },
    { href: localPath(lang, '/u/'), key: 'user.title', icon: 'person' },
  ] },
  { title: 'moreShop', links: [
    { href: localPath(lang, '/submit/'), key: 'aboutSuggestAction', icon: 'plus' },
  ] },
  { title: 'moreAbout', links: [
    { href: '/docs/', key: 'moreHelp', icon: 'book' },
    { href: localPath(lang, '/about/'), key: 'navAbout', icon: 'info' },
    { href: localPath(lang, '/privacy/'), key: 'navPrivacy', icon: 'shield' },
    { href: '/status/', key: 'navStatus', icon: 'pulse' },
    { href: config.repository, key: 'footerGithub', icon: 'code' },
    { href: `${config.repository}/issues`, key: 'contactGithub', icon: 'chat' },
    { href: config.analytics.publicDashboard, key: 'footerAnalytics', icon: 'chart' },
  ] },
];
---
<Base lang={lang} path="/more/" title={pageTitle(t(lang, 'moreTitle'))} description={t(lang, 'footerNote')} noindex strings={['profiles', 'account']}>
  <vf-more>
    <h1>{t(lang, 'moreTitle')}</h1>
    <section>
      <h2>{t(lang, 'moreSettings')}</h2>
      <CurrencySelect lang={lang} id="currency-more" />
      <nav aria-label={t(lang, 'navLanguage')}>
        <h3>{t(lang, 'navLanguage')}</h3>
        <ul>{languages.map((l) => (
          <li><a href={localPath(l, '/more/')} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{t(l, 'langName')}</a></li>
        ))}</ul>
      </nav>
    </section>
    <section id="account">
      <h2>{t(lang, 'account.title')}</h2>
      <vf-account state="out">
        <vf-account-status></vf-account-status>
        <form>
          <label for="account-handle">{t(lang, 'account.label')}</label>
          <vf-field>
            <input id="account-handle" name="handle" autocomplete="username" autocapitalize="off" spellcheck="false" required placeholder={t(lang, 'account.placeholder')}>
            <button type="submit"><vf-icon name="bluesky"></vf-icon><span>{t(lang, 'account.signIn')}</span></button>
          </vf-field>
        </form>
        <p>{t(lang, 'account.note')}</p>
        <fieldset name="publish">
          <legend>{t(lang, 'account.publishTitle')}</legend>
          <label><input type="checkbox" name="wants"> {t(lang, 'account.publishWants')}</label>
          <label><input type="checkbox" name="collection"> {t(lang, 'account.publishCollection')}</label>
          <p>{t(lang, 'account.publishNote')}</p>
          <p><a href={localPath(lang, '/u/')}><vf-icon name="person"></vf-icon><span>{t(lang, 'account.publicPage')}</span></a></p>
        </fieldset>
        <button type="button" name="signout" kind="secondary">{t(lang, 'account.signOut')}</button>
        <output aria-live="polite"></output>
      </vf-account>
    </section>
    <section id="profiles">
      <h2>{t(lang, 'profiles.title')}</h2>
      <vf-profiles>
        <ul></ul>
        <form>
          <label for="profile-name">{t(lang, 'profiles.add')}</label>
          <vf-field>
            <input id="profile-name" name="name" maxlength="40" autocomplete="off" placeholder={t(lang, 'profiles.addPlaceholder')}>
            <button type="submit" kind="secondary">{t(lang, 'profiles.addButton')}</button>
          </vf-field>
        </form>
        <p>{t(lang, 'profiles.note')}</p>
        <h3>{t(lang, 'profiles.transferTitle')}</h3>
        <p>{t(lang, 'profiles.transferIntro')}</p>
        <menu>
          <li><button type="button" name="export" kind="secondary"><vf-icon name="download"></vf-icon><span>{t(lang, 'profiles.export')}</span></button></li>
          <li><label><vf-icon name="plus"></vf-icon><span>{t(lang, 'profiles.import')}</span><input type="file" name="import" accept=".json,application/json"></label></li>
        </menu>
        <output aria-live="polite"></output>
        <!-- rename or remove a profile: a native dialog that keeps the profile unless confirmed (Cancel is focused) -->
        <dialog closedby="any" aria-labelledby="profile-dialog-title">
          <form method="dialog">
            <h2 id="profile-dialog-title"></h2>
            <label><span>{t(lang, 'profiles.renamePrompt')}</span><input name="name" maxlength="40" autocomplete="off"></label>
            <menu>
              <li><button value="cancel" kind="secondary" autofocus>{t(lang, 'profiles.cancel')}</button></li>
              <li><button value="ok"></button></li>
            </menu>
          </form>
        </dialog>
      </vf-profiles>
    </section>
    {groups.map((g) => (
      <section>
        <h2>{t(lang, g.title)}</h2>
        <ul>{g.links.map((n) => <li><a href={n.href}><vf-icon name={n.icon}></vf-icon><span>{t(lang, n.key)}</span></a></li>)}</ul>
      </section>
    ))}
    <p>{t(lang, 'footerNote')}</p>
  </vf-more>
</Base>
<script>
  import '../../components/vf-profiles.js';
  import '../../components/vf-account.js';
</script>
