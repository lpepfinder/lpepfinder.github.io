---
import Moved from '../../components/Moved.astro';
import { localeParams, localPath } from '../../lib/i18n.js';

/**
 * /explore/ was a tab of links (Dig, shops, cities, artists, formats, collectors, the data). Its parts live where
 * they belong now: shops and cities in the Shops tab, artists and collectors on Search, the data in Settings.
 * Old links and bookmarks go to Search.
 */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
---
<Moved to={localPath(lang, '/')} />
