---
import Base from '../../layouts/Base.astro';
import config from '../../../data/config.json';
import { t, localeParams } from '../../lib/i18n.js';

export const getStaticPaths = localeParams;
const { lang } = Astro.props;
---
<Base layout="prose" lang={lang} path="/submit/" title={`${t(lang, 'submitTitle')} · ${config.name}`} description={t(lang, 'submitBody')}>
  <article>
    <h1>{t(lang, 'submitTitle')}</h1>
    <p>{t(lang, 'submitBody')}</p>
    <p><a href={`${config.repository}/issues/new?template=shop.yml`}>{t(lang, 'submitAction')}</a></p>
  </article>
</Base>
