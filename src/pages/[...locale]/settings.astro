---
import Base from '../../layouts/Base.astro';
import CurrencySelect from '../../components/CurrencySelect.astro';
import Sheet from '../../components/Sheet.astro';
import config from '../../../data/config.json';
import { t, languages, localeParams, localPath } from '../../lib/i18n.js';
import { pageTitle } from '../../lib/seo.js';

/**
 * Settings (/settings/, was /more/; the fourth tab), as an app screen like joblist's Menu: the settings of
 * this browser first (language, prices in, moving to another device: rows that open their sheet),
 * then a shop to add, and about (help, privacy, data status, the open data for programs and agents, source).
 */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const groups = [
  { title: 'moreShop', links: [
    { href: localPath(lang, '/submit/'), key: 'aboutSuggestAction', icon: 'plus' },
    { href: localPath(lang, '/start/'), key: 'start.title', icon: 'store' },
  ] },
  { title: 'moreAbout', links: [
    { href: '/docs/', key: 'moreHelp', icon: 'book' },
    { href: localPath(lang, '/about/'), key: 'navAbout', icon: 'info' },
    { href: localPath(lang, '/privacy/'), key: 'navPrivacy', icon: 'shield' },
    { href: '/status/', key: 'navStatus', icon: 'pulse' },
    { href: '/api/index.json', key: 'explore.api', icon: 'code' },
    { href: '/llms.txt', key: 'explore.agents', icon: 'info' },
    { href: '/new/', key: 'dig.title', icon: 'sparkle' },
    { href: config.repository, key: 'footerGithub', icon: 'code' },
    { href: `${config.repository}/issues`, key: 'contactGithub', icon: 'chat' },
    { href: config.analytics.publicDashboard, key: 'footerAnalytics', icon: 'chart' },
  ] },
];
---
<Base lang={lang} path="/settings/" title={pageTitle(t(lang, 'settingsTitle'))} description={t(lang, 'footerNote')} noindex strings={['transfer', 'currency']}>
  <vf-settings>
    <h1>{t(lang, 'settingsTitle')}</h1>
    <!-- settings of this browser, as rows that open their sheet (savoir app-shell; joblist's Menu): each row shows its value -->
    <vf-settings-rows>
      <section>
        <h2>{t(lang, 'settingsBrowser')}</h2>
        <ul>
          <li><button type="button" value="language"><vf-icon name="globe"></vf-icon><span>{t(lang, 'navLanguage')}</span><data>{t(lang, 'langName')}</data></button></li>
          <li><button type="button" value="currency"><vf-icon name="coin"></vf-icon><span>{t(lang, 'currency.label')}</span><data></data></button></li>
          <li><button type="button" value="transfer"><vf-icon name="download"></vf-icon><span>{t(lang, 'transfer.title')}</span><data></data></button></li>
        </ul>
      </section>
      <Sheet lang={lang} name="transfer" mode="bottom" title={t(lang, 'transfer.title')}>
        <vf-sheet-body>
          <vf-transfer>
            <p>{t(lang, 'transfer.intro')}</p>
            <menu>
              <li><button type="button" name="export" kind="secondary"><vf-icon name="download"></vf-icon><span>{t(lang, 'transfer.download')}</span></button></li>
              <li><label><vf-icon name="plus"></vf-icon><span>{t(lang, 'transfer.open')}</span><input type="file" name="import" accept=".json,application/json"></label></li>
            </menu>
            <output aria-live="polite"></output>
          </vf-transfer>
        </vf-sheet-body>
      </Sheet>
      <Sheet lang={lang} name="currency" mode="bottom" title={t(lang, 'currency.label')}>
        <vf-sheet-body><CurrencySelect lang={lang} id="currency-more" /></vf-sheet-body>
      </Sheet>
    </vf-settings-rows>
    {groups.map((g) => (
      <section>
        <h2>{t(lang, g.title)}</h2>
        <ul>{g.links.map((n) => <li><a href={n.href}><vf-icon name={n.icon}></vf-icon><span>{t(lang, n.key)}</span></a></li>)}</ul>
      </section>
    ))}
    <p>{t(lang, 'footerNote')}</p>
  </vf-settings>
</Base>
<script>
  import '../../components/vf-transfer.js';
  import '../../components/vf-settings-rows.js';
</script>
