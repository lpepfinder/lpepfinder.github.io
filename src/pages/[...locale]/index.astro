---
import Base from '../../layouts/Base.astro';
import Results from '../../components/Results.astro';
import CountryTiles from '../../components/CountryTiles.astro';
import HomeStrip from '../../components/HomeStrip.astro';
import { homeStrip } from '../../lib/home-strip.js';
import config from '../../../data/config.json';
import { t, tn, localeParams, localPath, number, date } from '../../lib/i18n.js';
import { catalog } from '../../lib/catalog.js';
import { pageTitle } from '../../lib/seo.js';

export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const c = catalog();
const vars = {
  records: number(lang, c.totalRecords), shops: number(lang, c.visible.length), countries: number(lang, c.countries.length),
  searchable: number(lang, c.visible.filter((s) => s.records).length),
  recordsShort: new Intl.NumberFormat(lang, { notation: 'compact', maximumFractionDigits: 2 }).format(c.totalRecords),
};
const home = new URL(localPath(lang, '/'), Astro.site).href;
const strip = homeStrip(c, config.newArrivals.stripItems ?? config.newArrivals.homeItems);
const ld = [{
  '@context': 'https://schema.org', '@type': 'WebSite', name: config.name, alternateName: config.formerNames, url: home, inLanguage: lang,
  potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${home}?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
}, {
  '@context': 'https://schema.org', '@type': 'Organization', name: config.name, url: config.baseUrl, logo: new URL('/favicon.png', Astro.site).href,
}];
---
<Base lang={lang} path="/" mode="home" title={pageTitle(t(lang, 'homeSeoTitle'))} description={t(lang, 'description', vars)} ld={ld}>
  <hgroup>
    <h1>{t(lang, 'homeTitle')}</h1>
    <p>{t(lang, 'stats', vars)} · <time datetime={c.builtAt}>{t(lang, 'updated', { date: date(lang, c.builtAt) })}</time></p>
  </hgroup>
  <vf-recent hidden>
    <h2 id="recent-title">{t(lang, 'recent.title')}</h2>
    <vf-chips><ul aria-labelledby="recent-title"></ul></vf-chips>
    <button type="button" name="clear" kind="text" aria-label={t(lang, 'recent.clear')}>{t(lang, 'recent.clearShort')}</button>
  </vf-recent>
  <Results lang={lang} />
  <script>
    import '../../components/vf-recent.js';
  </script>
  <script is:inline>
    /* before first paint: a ?q= URL shows the results layout at once, so the home sections never shift */
    if (new URLSearchParams(location.search).get('q')) {
      document.querySelector('vf-app').setAttribute('mode', 'results');
      document.querySelector('vf-results').setAttribute('status', 'loading');
    }
  </script>
  <vf-home-card>
    <h2>{t(lang, 'homeWantsTitle')}</h2>
    <p>{t(lang, 'homeWantsBody')}</p>
    <a href={localPath(lang, '/watch/')} kind="strong">{t(lang, 'homeWantsAction')}</a>
  </vf-home-card>
  {strip.count > 0 && (
    <section aria-labelledby="home-new">
      <h2 id="home-new">{t(lang, strip.fresh ? 'homeNewTitle' : 'homeLatestTitle')}</h2>
      <HomeStrip lang={lang} records={strip.records} shopsById={c.shopsById} labelledby="home-new" />
      {strip.fresh && <p><a href="/new/">{tn(lang, 'homeNewAll', strip.count)}</a></p>}
    </section>
  )}
  <section aria-labelledby="home-countries">
    <h2 id="home-countries">{t(lang, 'homeCountriesTitle')}</h2>
    <CountryTiles lang={lang} countries={c.countries} />
    <p><a href={localPath(lang, '/shops/')}>{t(lang, 'homeAllShops', vars)}</a></p>
  </section>
  {c.artists.length > 0 && (
    <section aria-labelledby="home-artists">
      <h2 id="home-artists">{t(lang, 'homeArtistsTitle')}</h2>
      <vf-grid flow="columns" density="dense"><ul>{c.artists.slice(0, 40).map((a) => <li><a href={`/artist/${a.slug}/`}>{a.name}</a></li>)}</ul></vf-grid>
      <p><a href="/artists/">{t(lang, 'homeAllArtists')}</a></p>
    </section>
  )}
  <section aria-labelledby="home-why">
    <details>
      <summary><h2 id="home-why">{t(lang, 'homeWhyTitle')}</h2></summary>
      <ol>{t(lang, 'homeWhy').map((s) => <li>{s}</li>)}</ol>
    </details>
  </section>
</Base>
