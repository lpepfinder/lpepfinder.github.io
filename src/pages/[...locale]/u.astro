---
import Moved from '../../components/Moved.astro';
import { localeParams, localPath } from '../../lib/i18n.js';

/**
 * /u/ showed the lists a collector published on their Bluesky account. Publishing was removed on 2026-11-22
 * (nobody had published a list): old links go to Search.
 */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
---
<Moved to={localPath(lang, '/')} />
