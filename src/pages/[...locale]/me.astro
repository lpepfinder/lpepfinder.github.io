---
import Base from '../../layouts/Base.astro';
import WatchBackup from '../../components/WatchBackup.astro';
import WatchImport from '../../components/WatchImport.astro';
import RadioImport from '../../components/RadioImport.astro';
import CurrencySelect from '../../components/CurrencySelect.astro';
import Sheet from '../../components/Sheet.astro';
import { t, localeParams, localPath } from '../../lib/i18n.js';
import { pageTitle } from '../../lib/seo.js';

/**
 * Me (/me/, was /watch/), mobile first: the profile in use with a ⋯ menu (Prices in, Share, Profiles, Bluesky), then
 * the overview: one card per place the records come from (all of them, the Discogs wantlist, a radio, the search),
 * each with how many are watched and in stock, picked to show only its records in every view, and "Add a list" for
 * the lists not connected (all of them as cards while nothing is watched); then four tabs with counts (in stock,
 * shops, changes, all), filter chips, and the records in stock as search rows whose copies open in a detail pane.
 */
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const views = [['available', 'viewAvailable', 'bag'], ['now', 'viewShops', 'store'], ['changes', 'viewChanges', 'pulse'], ['all', 'viewAll', 'star']];
const sorts = ['new', 'price', 'price-desc', 'rare', 'rating', 'title'];
---
<Base lang={lang} path="/me/" title={pageTitle(t(lang, 'tabMe'))} description={t(lang, 'watchPage.description')} noindex strings={['watchPage', 'profiles', 'radio', 'sources', 'account']}>
  <vf-watch-shared hidden>
    <h2>{t(lang, 'watchPage.sharedTitle')}</h2>
    <p></p>
    <button type="button" name="add-shared" kind="secondary">{t(lang, 'watchPage.sharedAdd')}</button>
  </vf-watch-shared>
  <vf-me-head>
    <vf-avatar aria-hidden="true"><span>M</span></vf-avatar>
    <hgroup>
      <h1>{t(lang, 'profiles.default')}</h1>
      <p>{t(lang, 'profiles.local')}</p>
    </hgroup>
    <vf-menu>
      <button type="button" popovertarget="me-menu" aria-haspopup="menu" aria-expanded="false" kind="secondary" aria-label={t(lang, 'me.menu')} title={t(lang, 'me.menu')}><vf-icon name="more"></vf-icon></button>
      <menu popover id="me-menu">
        <li><button type="button" name="currency"><vf-icon name="coin"></vf-icon><span>{t(lang, 'currency.label')}</span> <data></data></button></li>
        <li><button type="button" name="share"><vf-icon name="share"></vf-icon><span>{t(lang, 'me.share')}</span></button></li>
        <li><a href={localPath(lang, '/settings/') + '#profiles'}><vf-icon name="person"></vf-icon><span>{t(lang, 'me.profiles')}</span></a></li>
        <li><a href={localPath(lang, '/settings/') + '#account'} name="sign-in"><vf-icon name="bluesky"></vf-icon><span>{t(lang, 'me.signIn')}</span></a></li>
        <li hidden><a href={localPath(lang, '/u/')} name="public"><vf-icon name="person"></vf-icon><span>{t(lang, 'me.publicPage')}</span></a></li>
      </menu>
    </vf-menu>
  </vf-me-head>
  <vf-watch-page status="idle" view="available" search={localPath(lang, '/')} empty>
    <vf-watch-sources>
      <h2 id="my-lists">{t(lang, 'me.lists')}</h2>
      <ul aria-labelledby="my-lists"></ul>
    </vf-watch-sources>
    <!-- nothing watched yet: the lists above connect one; any record of the search can be watched too -->
    <vf-watch-start>
      <p>{t(lang, 'me.empty')} <a href={localPath(lang, '/')}>{t(lang, 'me.emptySearch')}</a></p>
    </vf-watch-start>
    <Sheet lang={lang} name="discogs" mode="bottom" title={t(lang, 'watchPage.discogsTitle')}>
      <vf-sheet-body><WatchImport lang={lang} id="sheet" /></vf-sheet-body>
    </Sheet>
    <Sheet lang={lang} name="radio" mode="bottom" title={t(lang, 'radio.title')}>
      <vf-sheet-body><RadioImport lang={lang} id="sheet" /></vf-sheet-body>
    </Sheet>
    <Sheet lang={lang} name="share" mode="bottom" title={t(lang, 'me.share')}>
      <vf-sheet-body><WatchBackup lang={lang} /></vf-sheet-body>
    </Sheet>
    <Sheet lang={lang} name="currency" mode="bottom" title={t(lang, 'currency.label')}>
      <vf-sheet-body><CurrencySelect lang={lang} id="currency-watch" /></vf-sheet-body>
    </Sheet>
    <vf-progress hidden>
      <label for="watch-progress"></label>
      <progress id="watch-progress"></progress>
    </vf-progress>
    <output aria-live="polite"></output>
    <nav aria-label={t(lang, 'watchPage.views')}>
      <ul>
        {views.map(([view, label, icon], i) => <li><a href={`?view=${view}`} view={view} aria-current={i === 0 ? 'page' : undefined}><vf-icon name={icon}></vf-icon>{t(lang, `watchPage.${label}`)} <data></data></a></li>)}
      </ul>
    </nav>
    <vf-watch-filters>
      <form>
        <label><span>{t(lang, 'watchPage.sortLabel')}</span>
          <select name="sort">
            {sorts.map((v) => <option value={v}>{t(lang, `watchPage.sort.${v}`)}</option>)}
          </select>
        </label>
        <label><input type="checkbox" name="ships" checked><vf-icon name="truck"></vf-icon> {t(lang, 'watchPage.filterShips')}</label>
        <label><input type="checkbox" name="customs"><vf-icon name="globe"></vf-icon> {t(lang, 'watchPage.filterCustoms')}</label>
        <label><vf-icon name="coin"></vf-icon>{t(lang, 'watchPage.filterMax')} <input type="text" name="max" inputmode="decimal" size="4" autocomplete="off" placeholder="–"> <vf-currency-code>EUR</vf-currency-code></label>
      </form>
    </vf-watch-filters>
    <vf-watch-available count="">
      <h2 tabindex="-1">{t(lang, 'watchPage.availableHeading')}</h2>
      <p>{t(lang, 'watchPage.noneAvailable')}</p>
      <vf-split>
        <vf-watch-hits>
          <section name="new" hidden>
            <h3>{t(lang, 'watchPage.newSection')}</h3>
            <ol></ol>
          </section>
          <section name="rest">
            <h3 hidden>{t(lang, 'watchPage.restSection')}</h3>
            <ol></ol>
          </section>
          <vf-watch-showing></vf-watch-showing>
          <button type="button" name="more" kind="secondary" hidden></button>
        </vf-watch-hits>
        <Sheet lang={lang} name="watch-record" mode="adaptive" dock="(min-width: 64rem)" labelledby="detail-title" back={t(lang, 'watchPage.backRecords')} expandable>
          <vf-watch-record>
          <!-- why the record is on the list: a Discogs want, a radio's tracks, or added from the search -->
          <vf-watch-why hidden>
            <h3>{t(lang, 'watchPage.whyHeading')}</h3>
            <p source="discogs" hidden>
              <vf-badge kind="discogs">{t(lang, 'watchPage.badgeDiscogs')}</vf-badge>
              <span>{t(lang, 'watchPage.whyDiscogs')}</span>
              <vf-badge kind="rating"></vf-badge>
              <a target="_blank" rel="noopener nofollow" hidden><vf-icon name="external"></vf-icon>{t(lang, 'watchPage.seeDiscogs')}</a>
            </p>
            <vf-watch-tracks hidden>
              <h4><vf-badge kind="radio">{t(lang, 'watchPage.badgeRadio')}</vf-badge> {t(lang, 'watchPage.radioTracks')}</h4>
              <ul></ul>
            </vf-watch-tracks>
            <p source="search" hidden></p>
          </vf-watch-why>
          <vf-detail></vf-detail>
          <vf-watch-controls hidden>
            <form>
              <label>{t(lang, 'watchPage.maxPrice')} <input type="text" name="max" inputmode="decimal" size="5" autocomplete="off"> <vf-currency-code>EUR</vf-currency-code></label>
              <button type="submit" kind="secondary">{t(lang, 'watchPage.maxSave')}</button>
            </form>
            <menu>
              <li><button type="button" name="bought" kind="strong">{t(lang, 'watchPage.bought')}</button></li>
              <li><button type="button" name="remove" kind="text">{t(lang, 'watchPage.remove')}</button></li>
            </menu>
          </vf-watch-controls>
          </vf-watch-record>
        </Sheet>
      </vf-split>
    </vf-watch-available>
    <vf-watch-now count="" hidden>
      <h2 tabindex="-1">{t(lang, 'watchPage.shopsHeading')}</h2>
      <p>{t(lang, 'watchPage.noneAvailable')}</p>
      <vf-split>
        <vf-watch-shops><ul></ul></vf-watch-shops>
        <Sheet lang={lang} name="watch-shop" mode="adaptive" dock="(min-width: 64rem)" labelledby="watch-shop-title" back={t(lang, 'watchPage.backShops')} expandable>
          <vf-watch-shop-detail></vf-watch-shop-detail>
        </Sheet>
      </vf-split>
    </vf-watch-now>
    <vf-watch-changes count="" hidden>
      <h2 tabindex="-1">{t(lang, 'watchPage.changesHeading')}</h2>
      <p>{t(lang, 'watchPage.noChangesAll')}</p>
      <vf-watch-days></vf-watch-days>
    </vf-watch-changes>
    <vf-watch-all count="" hidden>
      <h2 id="watch-all" tabindex="-1">{t(lang, 'watchPage.allHeading')}</h2>
      <p>{t(lang, 'watchPage.emptyList')}</p>
      <search>
        <label for="watch-find">{t(lang, 'watchPage.findLabel')}</label>
        <input id="watch-find" type="search" placeholder={t(lang, 'watchPage.findPlaceholder')} autocomplete="off" spellcheck="false">
      </search>
      <nav aria-label={t(lang, 'watchPage.jumpLabel')}><ul></ul></nav>
      <ol aria-labelledby="watch-all"></ol>
      <vf-watch-showing></vf-watch-showing>
      <button type="button" name="more" kind="secondary" hidden></button>
    </vf-watch-all>
  </vf-watch-page>
</Base>
<script>
  import '../../components/vf-watch-page.js';
  import '../../components/vf-me-head.js';
  import '../../components/vf-menu.js';
  import '../../components/vf-watch-backup.js';
  import '../../components/vf-radio-import.js';
</script>
