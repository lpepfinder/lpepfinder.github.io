---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ShopList from '../../../components/ShopList.astro';
import { t, tn, localeParams, localPath, number, countryName } from '../../../lib/i18n.js';
import { pageTitle, breadcrumbLd } from '../../../lib/seo.js';
import { catalog } from '../../../lib/catalog.js';
import { byName, groupBy } from '../../../lib/sort.js';
import { cityName } from '../../../lib/cities.js';

export function getStaticPaths() {
  return localeParams().flatMap(({ params, props }) => catalog().countries.map((country) => ({
    params: { ...params, country: country.code.toLowerCase() },
    props: { ...props, country },
  })));
}
const { lang, country } = Astro.props;
const name = countryName(lang, country.code);
const vars = { country: name, shops: number(lang, country.shops.length), records: number(lang, country.records) };
// grouped by city (data/cities.json), cities A–Z in the page's language, those with a page linked; shops without
// a city come last; searchable shops first, then A–Z
const NONE = '';
const shopName = byName(lang, (s) => s.name);
const label = (city) => (city === NONE ? t(lang, 'cityUnknown') : cityName(lang, country.code, city));
const pages = new Map(country.pages.map((c) => [c.name, localPath(lang, `/shops/${country.code.toLowerCase()}/${c.slug}/`)]));
const cities = groupBy(country.shops, (s) => s.city || NONE,
  (a, b) => (a === NONE) - (b === NONE) || byName(lang)(label(a), label(b)), (a, b) => (b.records > 0) - (a.records > 0) || shopName(a, b));
const crumbs = [
  { name: t(lang, 'breadcrumbHome'), href: localPath(lang, '/') },
  { name: t(lang, 'navShops'), href: localPath(lang, '/shops/') },
  { name, href: localPath(lang, `/shops/${country.code.toLowerCase()}/`) },
];
const ld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: t(lang, 'countryTitle', vars), inLanguage: lang,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: country.shops.slice(0, 100).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/shop/${s.id}/`, Astro.site).href, name: s.name })),
  },
}, breadcrumbLd(crumbs, Astro.site)];
---
<Base lang={lang} path={`/shops/${country.code.toLowerCase()}/`} title={pageTitle(tn(lang, 'countrySeoTitle', country.shops.length, vars))} description={tn(lang, 'countryDescription', country.shops.length, vars)} ld={ld}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <h1>{t(lang, 'countryTitle', vars)}</h1>
  <p>{tn(lang, 'countryDescription', country.shops.length, vars)}</p>
  {cities.length > 1 && (
    <nav aria-label={t(lang, 'citiesNav')} sticky="phone">
      <ul>{cities.map(([city], i) => <li><a href={`#city-${i}`}>{label(city)}</a></li>)}</ul>
    </nav>
  )}
  <vf-grid flow="columns">
  {cities.map(([city, shops], i) => (
    <section id={`city-${i}`}>
      <h2>{pages.has(city) ? <a href={pages.get(city)}>{label(city)}</a> : label(city)} <data value={shops.length}>{number(lang, shops.length)}</data></h2>
      <ShopList lang={lang} shops={shops} />
    </section>
  ))}
  </vf-grid>
</Base>
