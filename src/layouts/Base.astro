---
import config from '../../data/config.json';
import { t, languages, defaultLanguage, localPath, clientStrings } from '../lib/i18n.js';
import Ads from '../components/Ads.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shortcuts from '../components/Shortcuts.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import historyGuard from '../components/history-guard.js?raw';

/**
 * Props:
 *  lang        page language
 *  path        language-neutral path when the page exists in every language ("/shops/"), else omit
 *  title, description, noindex, ld (JSON-LD objects)
 *  feed        { href, title } of the page's Atom feed, for feed readers
 *  data        URL of the page's data as JSON (/api/, docs/agents.md), for robots
 *  mode        "home" on the search home page (vf-search switches it to "results"), else "page"
 *  layout      "prose" caps the page at the text width (about, privacy); lists use the full width
 *  strings     extra i18n groups the page's browser components need (e.g. ["watchPage"])
 */
const { lang = defaultLanguage, path, title, description, noindex = false, ld = [], mode = 'page', layout, feed, data, strings: groups = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p) => new URL(p, Astro.site).href;
const strings = JSON.stringify(clientStrings(lang, groups)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <script is:inline set:html={historyGuard}></script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, follow">}
  <link rel="canonical" href={canonical}>
  {path && languages.map((l) => <link rel="alternate" hreflang={l} href={abs(localPath(l, path))}>)}
  {path && <link rel="alternate" hreflang="x-default" href={abs(localPath(defaultLanguage, path))}>}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={config.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={abs(`/og/${lang}.png`)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={lang}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="google-site-verification" content={config.googleSiteVerification}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <ClientRouter />
  <link rel="search" type="application/opensearchdescription+xml" href="/opensearch.xml" title={config.name}>
  {feed && <link rel="alternate" type="application/atom+xml" href={feed.href} title={feed.title}>}
  <link rel="alternate" type="application/json" href={data || '/api/index.json'}>
  <Ads />
  <script is:inline defer src={config.analytics.umamiScript} data-website-id={config.analytics.umamiWebsiteId}></script>
  <script is:inline type="application/json" data-i18n set:html={strings}></script>
  {ld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>)}
</head>
<body>
  <a href="#main">{t(lang, 'skipToContent')}</a>
  <vf-app mode={mode} layout={layout}>
    <Header lang={lang} current={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </vf-app>
  <Shortcuts lang={lang} />
  <script>
    import '../components/vf-app.js';
    import '../components/router.js';
  </script>
</body>
</html>
