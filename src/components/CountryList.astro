---
import { localPath, countryName, number } from '../lib/i18n.js';

const { lang, countries } = Astro.props;
---
<vf-grid><ul>
  {countries.map((c) => (
    <li><a href={localPath(lang, `/shops/${c.code.toLowerCase()}/`)}>{countryName(lang, c.code)}</a> <data value={c.shops.length}>{number(lang, c.shops.length)}</data></li>
  ))}
</ul></vf-grid>
