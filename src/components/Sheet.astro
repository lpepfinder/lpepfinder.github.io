---
import { t } from '../lib/i18n.js';

/**
 * <vf-sheet>: a native <dialog> as a bottom, side or full-screen sheet, docked in place while `dock` matches.
 * Props: lang, name, mode ("bottom" | "side" | "full"), dock (media query, optional), title (heading text;
 * omit it and fill the "header" slot instead), labelledby (id of the heading when there is no title).
 * Slots: default (content), "header" (replaces the title), "footer".
 */
const { lang, name, mode = 'bottom', dock, title, labelledby } = Astro.props;
const titleId = `${name}-sheet-title`;
---
<vf-sheet name={name} mode={mode} dock={dock}>
  <dialog aria-labelledby={title ? titleId : labelledby} closedby="any">
    <header>
      {Astro.slots.has('header') ? <slot name="header" /> : <h2 id={titleId}>{title}</h2>}
      <button type="button" value="close" kind="text" aria-label={t(lang, 'sheet.close')}><vf-icon name="close"></vf-icon></button>
    </header>
    <slot />
    {Astro.slots.has('footer') && <footer><slot name="footer" /></footer>}
  </dialog>
</vf-sheet>
<script>
  import './vf-sheet.js';
</script>
