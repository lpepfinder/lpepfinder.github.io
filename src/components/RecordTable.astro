---
import { t, price } from '../lib/i18n.js';

/** Records with price and shop; each row links out to the shop's product page. */
const { lang, records, shopsById } = Astro.props;
---
<figure>
  <table>
    <thead><tr>{t(lang, 'tableColumns').map((c) => <th scope="col">{c}</th>)}</tr></thead>
    <tbody>
      {records.map((r) => (
        <tr>
          <td><a href={r.url} rel="nofollow">{r.title}</a></td>
          <td><data value={r.price ?? ''}>{price(lang, r.price, r.currency)}</data></td>
          <td><a href={`/shop/${r.shop}/`}>{shopsById.get(r.shop)?.name || r.shop}</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</figure>
