---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RecordList from './RecordList.astro';
import { t, number, countryName } from '../lib/i18n.js';
import { newArrivals } from '../lib/new-arrivals.js';
import { pageTitle, breadcrumbLd } from '../lib/seo.js';
import { FORMAT_IDS } from '../lib/search/format.js';

/**
 * Body of the /new/ pages. scope: { key: "new" | "newCountry" | "newFormat", vars, href, records, count,
 * crumb (name of the last breadcrumb, if not /new/ itself), feed (Atom URL, optional), country, format }.
 */
const { lang, scope } = Astro.props;
const n = newArrivals();
const vars = { days: number(lang, n.days), shops: number(lang, n.shops), count: number(lang, scope.count), ...scope.vars };
const crumbs = [
  { name: t(lang, 'breadcrumbHome'), href: '/' },
  { name: t(lang, 'navNew'), href: '/new/' },
  ...(scope.crumb ? [{ name: scope.crumb, href: scope.href }] : []),
];
const ld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: t(lang, `${scope.key}Title`, vars), inLanguage: lang }, breadcrumbLd(crumbs, Astro.site)];
const feed = scope.feed && { href: scope.feed, title: t(lang, 'newFeed') };
const formats = FORMAT_IDS.filter((f) => n.formatIds.includes(f));
// the Dig crates (vf-dig.js) on /new/ itself; the server-rendered list below stays for search engines and without scripts
const crates = ['mine', 'new', 'restock', 'drop'];
const crateIcons = { mine: 'star', new: 'sparkle', restock: 'refresh', drop: 'trend-down' };
---
<Base lang={lang} title={pageTitle(t(lang, `${scope.key}SeoTitle`, vars))} description={t(lang, `${scope.key}Description`, vars)} ld={ld} feed={feed} noindex={!scope.count} strings={['dig']}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <hgroup>
    <h1 id="new-title">{scope.key === 'new' ? t(lang, 'dig.title') : t(lang, `${scope.key}Title`, vars)}</h1>
    <p>{scope.key === 'new' ? t(lang, 'dig.intro') : scope.count ? t(lang, `${scope.key}Description`, vars) : t(lang, 'newEmpty', vars)}</p>
  </hgroup>
  {scope.key === 'new' && (
    <vf-dig crate="new" status="loading">
      <nav aria-label={t(lang, 'dig.crates')}><ul>
        {crates.map((c) => <li><a href={`?crate=${c}`} crate={c} aria-current={c === 'new' ? 'page' : undefined}><vf-icon name={crateIcons[c]}></vf-icon>{t(lang, `dig.crate.${c}`)} <data></data></a></li>)}
      </ul></nav>
      <form>
        <label><input type="checkbox" name="ships" checked><vf-icon name="truck"></vf-icon> {t(lang, 'dig.ships')}</label>
        <label><input type="checkbox" name="customs"><vf-icon name="globe"></vf-icon> {t(lang, 'dig.customs')}</label>
        <label><vf-icon name="record"></vf-icon><span>{t(lang, 'dig.format')}</span>
          <select name="format">
            <option value="">{t(lang, 'newAllFormats')}</option>
            {FORMAT_IDS.map((f) => <option value={f}>{t(lang, `formats.${f}`)}</option>)}
          </select>
        </label>
      </form>
      <ol></ol>
      <vf-dig-status aria-live="polite"></vf-dig-status>
      <button type="button" name="more" kind="secondary" hidden><vf-icon name="chevron-down"></vf-icon><span>{t(lang, 'dig.more')}</span></button>
    </vf-dig>
  )}
  {formats.length > 0 && (
    <section>
      <h2>{t(lang, 'newByFormat')}</h2>
      <vf-chips><ul>
        <li><a href="/new/" aria-current={scope.key === 'new' ? 'page' : undefined}>{t(lang, 'newAllFormats')}</a></li>
        {formats.map((f) => <li><a href={`/new/format/${f}/`} aria-current={scope.format === f ? 'page' : undefined}>{t(lang, `formats.${f}`)}</a></li>)}
      </ul></vf-chips>
    </section>
  )}
  {scope.records.length > 0 && <RecordList lang={lang} records={scope.records} labelledby="new-title" />}
  {scope.count > scope.records.length && <p>{t(lang, 'newShowing', { ...vars, shown: number(lang, scope.records.length) })}</p>}
  {feed && <p><a href={feed.href} type="application/atom+xml"><vf-icon name="rss"></vf-icon>{feed.title}</a></p>}
  {n.countryCodes.length > 0 && (
    <section>
      <h2>{t(lang, 'newByCountry')}</h2>
      <vf-chips><ul>{n.countryCodes.map((cc) => (
        <li><a href={`/new/${cc.toLowerCase()}/`} aria-current={scope.country === cc ? 'page' : undefined}>{countryName(lang, cc)} ({number(lang, n.countries[cc].count)})</a></li>
      ))}</ul></vf-chips>
    </section>
  )}
</Base>
<script>
  import './vf-dig.js';
</script>
