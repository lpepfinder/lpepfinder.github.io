---
import config from '../../data/config.json';
import SearchForm from './SearchForm.astro';
import TabBar from './TabBar.astro';
import { localPath } from '../lib/i18n.js';

/** App header: brand and search. The app's tabs (search, new, watchlist) sit at the bottom on phones, in the header on wide screens. */
const { lang, current } = Astro.props;
---
<header>
  <a href={localPath(lang, '/')} rel="home"><img src="/favicon.png" alt="" width="28" height="28"> <span>{config.name}</span></a>
  <SearchForm lang={lang} />
  <TabBar lang={lang} current={current} />
</header>
