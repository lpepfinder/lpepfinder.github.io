---
import { t, localPath } from '../lib/i18n.js';
import Logo from './Logo.astro';

/**
 * The app's four tabs (savoir app-shell): Search (its icon is the brand; home), Shops (/shops/: where the shops are,
 * current on the pages about shops, places, artists and new arrivals), Me (the lists and records watched, with
 * their count of changes) and Settings (language, prices in, moving the list; then help and about).
 */
const { lang, current } = Astro.props;
const search = localPath(lang, '/');
const shops = localPath(lang, '/shops/');
const me = localPath(lang, '/me/');
const settings = localPath(lang, '/settings/');
const here = (href) => (href === current ? 'page' : undefined);
const inShops = (href) => (href === current ? 'page' : /^(\/[a-z]{2})?\/(shops|shop|new|artists|artist)\//.test(current || '') ? 'true' : undefined);
---
<nav aria-label={t(lang, 'navApp')}>
  <vf-tabbar>
    <a href={search} aria-current={here(search)} title={t(lang, 'tabSearch')}><Logo /><span>{t(lang, 'tabSearch')}</span></a>
    <a href={shops} aria-current={inShops(shops)} title={t(lang, 'tabShops')}><vf-icon name="store"></vf-icon><span>{t(lang, 'tabShops')}</span></a>
    <vf-watchlist>
      <a href={me} aria-current={here(me)} title={t(lang, 'tabMe')} rel="me"><vf-icon name="person"></vf-icon><span>{t(lang, 'tabMe')}</span> <vf-watch-count count="0"></vf-watch-count></a>
    </vf-watchlist>
    <a href={settings} aria-current={here(settings)} title={t(lang, 'tabSettings')}><vf-icon name="settings"></vf-icon><span>{t(lang, 'tabSettings')}</span></a>
  </vf-tabbar>
</nav>
<script>
  import './vf-watchlist.js';
</script>
