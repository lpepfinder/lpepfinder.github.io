---
import { t } from '../lib/i18n.js';

/**
 * <vf-watch-import>: a Discogs wantlist by username, or its CSV export (vf-watch-import.js).
 * Used twice on the watch page: the start screen of an empty list, and the Discogs sheet. id: prefix of field ids.
 */
const { lang, id } = Astro.props;
---
<vf-watch-import status="idle">
  <form>
    <label for={`${id}-discogs-user`}>{t(lang, 'watchPage.discogsUser')}</label>
    <vf-field>
      <input id={`${id}-discogs-user`} name="user" autocomplete="off" autocapitalize="off" spellcheck="false" required placeholder={t(lang, 'watchPage.discogsUserPlaceholder')}>
      <button type="submit">{t(lang, 'watchPage.discogsImport')}</button>
    </vf-field>
  </form>
  <p>{t(lang, 'watchPage.discogsPublic')}</p>
  <p><label>{t(lang, 'watchPage.csvLabel')} <input type="file" name="csv" accept=".csv,text/csv"></label></p>
  <vf-progress hidden>
    <label for={`${id}-discogs-progress`}></label>
    <progress id={`${id}-discogs-progress`}></progress>
  </vf-progress>
  <output aria-live="polite"></output>
</vf-watch-import>
