---
import { t, localPath } from '../lib/i18n.js';

/** Discogs wantlist import (by username, or a CSV export when the list is private); vf-discogs-import.js. */
const { lang } = Astro.props;
---
<vf-discogs-import step="user" search={localPath(lang, '/')}>
  <h2>{t(lang, 'discogs.title')}</h2>
  <p>{t(lang, 'discogs.privacy')}</p>
  <form>
    <label for="discogs-user">{t(lang, 'discogs.username')}</label>
    <input id="discogs-user" name="user" required autocomplete="username" autocapitalize="none" spellcheck="false" enterkeyhint="go">
    <button type="submit">{t(lang, 'discogs.check')}</button>
    <label><input type="checkbox" name="other"> {t(lang, 'discogs.includeOther')}</label>
  </form>
  <vf-discogs-note reason="private">{t(lang, 'discogs.private')}</vf-discogs-note>
  <p>{t(lang, 'discogs.or')}</p>
  <label>{t(lang, 'discogs.csv')} <input type="file" name="csv" accept=".csv,text/csv"></label>
  <p>{t(lang, 'discogs.csvHint')}</p>
  <vf-progress hidden>
    <label for="discogs-progress"></label>
    <progress id="discogs-progress"></progress>
  </vf-progress>
  <output aria-live="polite"></output>
  <vf-discogs-results hidden>
    <h3>{t(lang, 'discogs.inStockTitle')}</h3>
    <ul></ul>
    <h3>{t(lang, 'discogs.soldOutTitle')}</h3>
    <ul></ul>
    <button type="button" name="watch-all"></button>
  </vf-discogs-results>
  <p><small><a href="https://www.discogs.com/" rel="noopener">{t(lang, 'discogs.attribution')}</a></small></p>
</vf-discogs-import>
