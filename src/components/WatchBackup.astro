---
import { t } from '../lib/i18n.js';

/** Export, import and share link of the watchlist; filled in by vf-watch-backup.js. */
const { lang } = Astro.props;
---
<vf-watch-backup>
  <h2>{t(lang, 'watchPage.backupTitle')}</h2>
  <p>{t(lang, 'watchPage.backupIntro')}</p>
  <menu>
    <li><button type="button" name="export">{t(lang, 'watchPage.export')}</button></li>
    <li><label>{t(lang, 'watchPage.import')} <input type="file" name="import" accept=".json,application/json"></label></li>
    <li><button type="button" name="share">{t(lang, 'watchPage.share')}</button></li>
  </menu>
  <p hidden><label for="watch-share-url">{t(lang, 'watchPage.shareLabel')}</label> <input id="watch-share-url" type="url" readonly></p>
  <p>{t(lang, 'watchPage.shareHint')}</p>
  <output aria-live="polite"></output>
</vf-watch-backup>
