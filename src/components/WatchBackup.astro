---
import { t, localPath } from '../lib/i18n.js';

/** The watchlist's share link; filled in by vf-watch-backup.js. Moving a whole profile (a file) is in More → Profiles. */
const { lang } = Astro.props;
---
<vf-watch-backup>
  <p>{t(lang, 'watchPage.backupIntro')} <a href={localPath(lang, '/settings/') + '#transfer'}>{t(lang, 'watchPage.backupMove')}</a></p>
  <menu>
    <li><button type="button" name="share" kind="secondary">{t(lang, 'watchPage.share')}</button></li>
  </menu>
  <p hidden><label for="watch-share-url">{t(lang, 'watchPage.shareLabel')}</label> <input id="watch-share-url" type="url" readonly></p>
  <p>{t(lang, 'watchPage.shareHint')}</p>
  <output aria-live="polite"></output>
</vf-watch-backup>
