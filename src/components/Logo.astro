---
/**
 * <vf-logo>: the LP/EP Finder mark, a magnifier whose lens holds a record. Inline SVG so it takes the theme's
 * colors (header.css); the record spins at 33⅓ rpm on hover and while a search loads.
 */
---
<vf-logo aria-hidden="true">
  <svg viewBox="0 0 32 32" width="28" height="28" focusable="false">
    <path part="handle" d="M9.6 19.6 3.2 26a2 2 0 0 0 2.8 2.8l6.4-6.4z"/>
    <circle part="ring" cx="19" cy="13" r="10.5"/>
    <g part="disc">
      <circle part="vinyl" cx="19" cy="13" r="8"/>
      <circle part="groove" cx="19" cy="13" r="6.6"/>
      <circle part="groove" cx="19" cy="13" r="5.2"/>
      <path part="sheen" d="M13.2 9.6a6.7 6.7 0 0 1 4.3-3.3"/>
      <circle part="label" cx="19" cy="13" r="2.6"/>
      <circle part="hole" cx="19" cy="13" r="0.7"/>
    </g>
  </svg>
</vf-logo>
