---
import config from '../../data/config.json';
import { t } from '../lib/i18n.js';

/**
 * A fixed-height ad spot (<vf-ad place="…">) for config.ads.slots[place] (an AdSense ad unit id).
 * Without that setting it renders nothing, so it takes no space. template: render it inside a
 * <template> for the browser to copy into a list (between pages of results).
 */
const { lang, place, template = false } = Astro.props;
const slot = config.ads.enabled ? config.ads.slots?.[place] : null;
---
{slot && !template && <vf-ad place={place} unit={slot} client={config.ads.adsenseClient} aria-label={t(lang, 'adLabel')} role="complementary"></vf-ad>}
{slot && template && <template data-ad={place}><vf-ad place={place} unit={slot} client={config.ads.adsenseClient} aria-label={t(lang, 'adLabel')} role="complementary"></vf-ad></template>}
