---
import { t, localPath, number } from '../lib/i18n.js';
import { catalog } from '../lib/catalog.js';
import facets from '../../data/facets.json';
import CurrencySelect from './CurrencySelect.astro';

/**
 * Results region filled by <vf-search>: heading and count line, filters (controls of the search
 * form, so the URL shares them), short live status, the list of releases, empty states.
 */
const { lang } = Astro.props;
const listed = catalog().visible.filter((s) => !s.records).length;
const shops = localPath(lang, '/shops/');
---
<vf-results status="idle" aria-busy="false" covers="on">
  <vf-results-bar>
    <h2 id="results-title" tabindex="-1"></h2>
    <p></p>
    <CurrencySelect lang={lang} id="currency-results" />
    <button type="button" name="share" kind="secondary">{t(lang, 'results.copyLink')}</button>
  </vf-results-bar>
  <vf-filters>
    <fieldset name="show">
      <legend>{t(lang, 'results.filtersLabel')}</legend>
      <label><input type="checkbox" name="stock" value="in" form="search"> {t(lang, 'results.inStock')}</label>
      <label><input type="checkbox" name="near" value="1" form="search" checked> <span>{t(lang, 'results.near')}</span></label>
      <label><input type="checkbox" name="covers" role="switch" checked> {t(lang, 'results.covers')}</label>
    </fieldset>
    <fieldset name="format" hidden>
      <legend>{t(lang, 'results.formatLabel')}</legend>
      {facets.display.map((id) => (
        <label hidden><input type="checkbox" name="format" value={id} form="search"> {t(lang, `formats.${id}`)} <data value="0"></data></label>
      ))}
    </fieldset>
  </vf-filters>
  <output aria-live="polite" aria-atomic="true"></output>
  <ol aria-labelledby="results-title"></ol>
  <vf-note reason="filtered" hidden><p>{t(lang, 'results.noneFiltered')}</p></vf-note>
  <button type="button" name="more" kind="secondary" hidden>{t(lang, 'loadMore')}</button>
  <vf-empty reason="no-match">
    <h2 tabindex="-1"></h2>
    <vf-suggest hidden></vf-suggest>
    <ul>
      <li>{t(lang, 'emptyFewerWords')}</li>
      <li><a href={shops}>{t(lang, 'emptyListedShops', { count: number(lang, listed) })}</a></li>
    </ul>
  </vf-empty>
  <vf-empty reason="index-error">
    <h2 tabindex="-1">{t(lang, 'indexError')}</h2>
    <p><button type="button" name="retry" kind="secondary">{t(lang, 'retry')}</button> <a href={shops}>{t(lang, 'navShops')}</a></p>
  </vf-empty>
</vf-results>
