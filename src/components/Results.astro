---
import { t, localPath, number } from '../lib/i18n.js';
import { catalog } from '../lib/catalog.js';
import FiltersSheet from './FiltersSheet.astro';
import Sheet from './Sheet.astro';

/**
 * Results region filled by <vf-search>, a <vf-split>: the filters (a sheet, the left rail from 90rem),
 * the list (heading, count line, releases) and the release detail (a sheet, the right pane from 64rem);
 * a floating Filters button on phones; a short live status; empty states.
 */
const { lang } = Astro.props;
const listed = catalog().visible.filter((s) => !s.records).length;
const shops = localPath(lang, '/shops/');
---
<vf-results status="idle" aria-busy="false" covers="on">
  <!-- the index is read in the browser: without JavaScript, the static pages are the way in -->
  <noscript><p>{t(lang, 'noscriptSearch')} <a href="/artists/">{t(lang, 'navArtists')}</a> · <a href={shops}>{t(lang, 'navShops')}</a></p></noscript>
  <vf-places hidden>
    <nav aria-label={t(lang, 'results.places')}><ul></ul></nav>
  </vf-places>
  <vf-split>
  <FiltersSheet lang={lang} />
  <section aria-labelledby="results-title">
  <vf-results-bar>
    <h2 id="results-title" tabindex="-1"></h2>
    <p></p>
    <button type="button" name="filters" kind="secondary"><vf-icon name="filter"></vf-icon><span>{t(lang, 'results.filters')}</span></button>
  </vf-results-bar>
  <ol aria-labelledby="results-title"></ol>
  <vf-note reason="filtered" hidden><p>{t(lang, 'results.noneFiltered')}</p></vf-note>
  <button type="button" name="more" kind="secondary" hidden><vf-icon name="chevron-down"></vf-icon><span>{t(lang, 'loadMore')}</span></button>
  </section>
  <Sheet lang={lang} name="release" mode="adaptive" dock="(min-width: 64rem)" labelledby="detail-title" back={t(lang, 'detail.back')} expandable>
    <vf-detail status="empty"></vf-detail>
  </Sheet>
  </vf-split>
  <vf-results-actions><button type="button" name="filters" kind="strong"><vf-icon name="filter"></vf-icon><span>{t(lang, 'results.filters')}</span></button></vf-results-actions>
  <output aria-live="polite" aria-atomic="true"></output>
  <vf-empty reason="no-match">
    <h2 tabindex="-1"></h2>
    <vf-suggest hidden></vf-suggest>
    <ul>
      <li>{t(lang, 'emptyFewerWords')}</li>
      <li><a href={shops}>{t(lang, 'emptyListedShops', { count: number(lang, listed) })}</a></li>
    </ul>
  </vf-empty>
  <vf-empty reason="index-error">
    <h2 tabindex="-1">{t(lang, 'indexError')}</h2>
    <p><button type="button" name="retry" kind="secondary">{t(lang, 'retry')}</button> <a href={shops}>{t(lang, 'navShops')}</a></p>
  </vf-empty>
</vf-results>
