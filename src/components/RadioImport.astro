---
import { t } from '../lib/i18n.js';

/**
 * <vf-radio-import>: records in stock for the tracks of a Radio4000 radio (atproto), reviewed before they're
 * added to the watchlist (vf-radio-import.js). id: prefix of field ids.
 */
const { lang, id } = Astro.props;
---
<vf-radio-import status="idle">
  <form>
    <label for={`${id}-radio`}>{t(lang, 'radio.label')}</label>
    <vf-field>
      <input id={`${id}-radio`} name="handle" autocomplete="off" autocapitalize="off" spellcheck="false" required placeholder={t(lang, 'radio.placeholder')}>
      <button type="submit">{t(lang, 'radio.find')}</button>
    </vf-field>
  </form>
  <vf-progress hidden><label for={`${id}-radio-progress`}></label><progress id={`${id}-radio-progress`}></progress></vf-progress>
  <output aria-live="polite"></output>
  <ol></ol>
  <button type="button" name="add" hidden></button>
</vf-radio-import>
