---
import ResultCard from './ResultCard.astro';
import { catalog } from '../lib/catalog.js';

/** A static list of record cards (new arrivals, a shop's records); `labelledby` is the id of its heading; showShop false on a shop's page. */
const { lang, records, labelledby, showShop = true } = Astro.props;
const shops = catalog().shopsById;
---
<vf-record-list count={records.length}>
  <ol aria-labelledby={labelledby}>
    {records.map((r, i) => <li><ResultCard lang={lang} record={r} shopName={showShop ? shops.get(r.shop)?.name || r.shop : null} index={i} /></li>)}
  </ol>
</vf-record-list>
