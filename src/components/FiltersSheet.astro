---
import { t } from '../lib/i18n.js';
import facets from '../../data/facets.json';
import CurrencySelect from './CurrencySelect.astro';
import Sheet from './Sheet.astro';

/**
 * The results' filters in a <vf-sheet>: a bottom sheet opened by the Filters buttons, docked as the
 * left rail from 90rem. The toggles are controls of the search form (form="search"), so the URL keeps
 * stock, near and format. Changes apply at once; "Show 312 records" only closes the sheet.
 */
const { lang } = Astro.props;
---
<Sheet lang={lang} name="filters" mode="bottom" dock="(min-width: 110rem)" title={t(lang, 'results.filters')}>
  <vf-filters>
    <fieldset name="show">
      <legend>{t(lang, 'results.showLabel')}</legend>
      <label><input type="checkbox" name="stock" value="in" form="search"> {t(lang, 'results.inStock')}</label>
      <label><input type="checkbox" name="near" value="1" form="search" checked> <span>{t(lang, 'results.near')}</span></label>
    </fieldset>
    <fieldset name="format" hidden>
      <legend>{t(lang, 'results.formatLabel')}</legend>
      {facets.display.map((id) => (
        <label hidden><input type="checkbox" name="format" value={id} form="search"> {t(lang, `formats.${id}`)} <data value="0"></data></label>
      ))}
    </fieldset>
    <fieldset name="currency">
      <legend>{t(lang, 'currency.label')}</legend>
      <CurrencySelect lang={lang} id="currency-results" />
    </fieldset>
    <fieldset name="display">
      <legend>{t(lang, 'results.displayLabel')}</legend>
      <label><input type="checkbox" name="covers" role="switch" checked> {t(lang, 'results.covers')}</label>
    </fieldset>
  </vf-filters>
  <Fragment slot="footer">
    <button type="button" name="share" kind="secondary">{t(lang, 'results.copyLink')}</button>
    <button type="button" value="close" kind="strong"></button>
  </Fragment>
</Sheet>
