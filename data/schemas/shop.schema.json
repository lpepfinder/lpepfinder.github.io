{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record shop",
  "description": "One file per shop in data/shops/<host>.json. Machine state (status, platform, name from the site) is computed weekly and not stored here.",
  "type": "object",
  "required": [
    "url"
  ],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https?://[^/]+$",
      "description": "Shop origin, no path"
    },
    "name": {
      "type": "string",
      "description": "Overrides the name read from the shop"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "discogs": {
      "type": "string",
      "pattern": "^https://www\\.discogs\\.com/"
    },
    "osm": {
      "type": "string",
      "description": "OpenStreetMap element, e.g. node/123"
    },
    "source": {
      "type": "string",
      "enum": [
        "cse",
        "discogs",
        "osm",
        "rsd",
        "wikidata",
        "submission",
        "manual"
      ]
    },
    "disabled": {
      "type": "boolean",
      "description": "Exclude from crawl and site (e.g. on owner request)"
    },
    "note": {
      "type": "string"
    },
    "crawl": {
      "type": "object",
      "description": "Overrides for the site crawler (npm run site), for shops without a catalog API",
      "additionalProperties": false,
      "properties": {
        "skip": {
          "type": "boolean",
          "description": "Never crawl this shop's pages"
        },
        "method": {
          "type": "string",
          "enum": [
            "squarespace-json",
            "bigcartel",
            "magento-graphql",
            "app-data",
            "sitemap",
            "generic"
          ],
          "description": "Use this reader instead of probing for one"
        },
        "pagesPerDay": {
          "type": "integer",
          "description": "Requests per day for this shop (default site.pagesPerDay)"
        },
        "delayMs": {
          "type": "integer",
          "description": "Minimum time between two requests (robots.txt crawl-delay wins when larger)"
        },
        "start": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "description": "Extra start paths, e.g. [\"/genres\", \"/labels\"]"
        }
      }
    }
  }
}
