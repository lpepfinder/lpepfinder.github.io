{
  "name": "vinyl-finder",
  "version": "2.0.0",
  "private": true,
  "description": "Search engine for vinyl records in independent record shops worldwide",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/data/validate.js",
    "check": "node scripts/check/index.js",
    "crawl": "node scripts/crawl/index.js",
    "discover": "node scripts/discover/index.js",
    "index": "node scripts/index/build.js",
    "refresh": "npm run check && npm run crawl",
    "dev": "astro dev",
    "build": "npm run validate && npm run rates && npm run index && astro build",
    "preview": "astro preview",
    "test": "node --test 'scripts/**/*.test.js'",
    "submit": "node scripts/submit/index.js",
    "site": "node scripts/sources/site/index.js",
    "stats": "node scripts/stats/index.js",
    "rates": "node scripts/rates/index.js"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  }
}
